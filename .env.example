# Public URL of the deployed site (canonical URLs, sitemap, hreflang, share images).
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Keystatic GitHub mode ------------------------------------------------
# Setting this switches Keystatic from local mode (edits write to /content)
# to GitHub mode (every save is a commit). Set it on Vercel. Locally, only set
# it for the one-time GitHub App setup (see README), then remove it again.
# Format: owner/repo, e.g. AhmadAbuHas/my-portfolio
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=

# Generated by Keystatic during the GitHub App setup (it writes them to .env).
# Copy them to Vercel.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
